# 줄바꿈 정책 (Windows + macOS 혼용)
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.py text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
