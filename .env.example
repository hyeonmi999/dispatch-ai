# ==================================================
# 통합 배차 AI Agent - 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 커밋 금지)
# ==================================================

# 공공데이터포털(data.go.kr) 인증키
# - 서울특별시 버스노선정보조회 (노선 경로·정류소 좌표, 길안내용 전체 노선 정류장·시간표). 디코딩(Decoding) 키를 넣습니다
# - 기상청 지상(ASOS) 시간자료 조회
DATA_GO_KR_API_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) 일반 인증키 (선택) - 관제 화면의 실시간 돌발·정체 알림 (TOPIS)
# 이용 안내 → Open API 소개 → "인증키 신청 - 일반". 없으면 실시간은 꺼지고 기록 다시 보기만 됨
SEOUL_OPEN_API_KEY=

# OpenAI (선택) - LLM을 openai로 고를 때만 필요
OPENAI_API_KEY=

# Hugging Face (선택) - Qwen3 / bge-m3는 공개 모델이라 없어도 동작
HF_TOKEN=

# MariaDB (docker/maria_db.yml 기준, 포트 3379)
ASYNC_DB_URL=mysql+aiomysql://manager:SqlDba-1@127.0.0.1:3379/dispatch_ai?charset=utf8mb4

# 데이터 모드: auto(실데이터 있으면 real, 없으면 sample) | real | sample
DATA_MODE=auto

# 기본 LLM / 임베딩
DEFAULT_LLM=qwen
DEFAULT_EMBEDDING=bge

# 로컬 LLM: 팀 공통으로 Qwen/Qwen3-1.7B 하나만 씁니다 (약 4GB, 처음 쓸 때 자동 다운로드)
LOCAL_MODEL_NAME=Qwen/Qwen3-1.7B
# LoRA 어댑터 경로 (scripts/finetune_lora.py 결과, 비우면 미사용)
LOCAL_ADAPTER=
